<schemalist>
  <schema id="dev.roither.belegablage"
          path="/dev/roither/belegablage/"
          gettext-domain="beleg-ablage">
    <key name="belege-root" type="s">
      <default>""</default>
      <summary>Belegarchiv-Stammverzeichnis</summary>
      <description>
        Absolute path to the root of the receipt archive. Transaction
        documents live below it as belege/&lt;YYYY-MM&gt;/B&lt;YYMM&gt;-&lt;Nr&gt;_&lt;Kurzname&gt;.pdf.
        When empty, the module falls back to the GnuCash document-link
        path head (Edit → Preferences → Business/Documents).
      </description>
    </key>
  </schema>
</schemalist>
