  explicit Stage 2 task.
-->
<interface>
  <menu id="ToolsPlaceholder0">
    <item>
      <attribute name="label">Beleg _zuordnen…</attribute>
      <attribute name="action">gnc-plugin-beleg-ablage-actions.BelegAssignAction</attribute>
    </item>
    <item>
      <attribute name="label">Beleg _öffnen</attribute>
      <attribute name="action">gnc-plugin-beleg-ablage-actions.BelegOpenAction</attribute>
    </item>
    <item>
      <attribute name="label">Beleg-_Info…</attribute>
      <attribute name="action">gnc-plugin-beleg-ablage-actions.BelegInfoAction</attribute>
    </item>
  </menu>
</interface>
